# Application Configuration
APP_NAME=production-rag-system
APP_VERSION=1.0.0
ENVIRONMENT=production

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
API_V1_PREFIX=/api/v1

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Weaviate Configuration
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_GRPC_URL=weaviate:50051
WEAVIATE_CLASS_NAME=Documents

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=3600

# MariaDB Configuration
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=rag_metadata
MARIADB_USER=rag_user
MARIADB_PASSWORD=rag_password_change_in_production
MARIADB_ROOT_PASSWORD=root_password_change_in_production

# Prometheus Configuration
PROMETHEUS_PORT=9090

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Nginx Configuration
NGINX_PORT=80

# Document Processing
MAX_UPLOAD_SIZE=52428800
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Logging
LOG_LEVEL=INFO
